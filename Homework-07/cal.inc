; ============================================================
; cal.inc : 宏汇编 (Macro) 定义, 供各模块 INCLUDE
; 宏和过程(proc)的区别:
;   宏在汇编时展开, 每用一次就复制一段代码, 没有 call/ret 开销;
;   过程在链接后只有一份代码, 调用有压栈/返回开销。
; 小功能(如打印一个字符)用宏更直观。
; ============================================================

; 打印一个字符, 不破坏调用处的寄存器
printc MACRO ch
    push dx
    mov dl,ch
    mov ah,2
    int 21h
    pop dx
ENDM

; 输出回车换行
newline MACRO
    printc 0dh
    printc 0ah
ENDM